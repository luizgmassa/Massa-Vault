NOTES_AUTOMATION_GIT_AUTO_PUSH=true
NOTES_AUTOMATION_GDRIVE_BIN=rclone
NOTES_AUTOMATION_GDRIVE_REMOTE_PATH=

MASSA_VAULT_CHAT_GATEWAY_URL=http://127.0.0.1:4100
MASSA_VAULT_CHAT_SYSTEM_PROMPT=
MASSA_VAULT_OLLAMA_URL=http://127.0.0.1:11434
MASSA_VAULT_EMBED_MODEL=embeddinggemma
