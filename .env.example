# DEPRECATED: .env is superseded by the home config at
# ~/.config/massa-ai-vault/config.json (outside any checkout). Run
# `massa-vault config migrate` to move these settings there; .env keeps
# working (ranked below the home config, above repo config/*.json defaults)
# but is no longer the recommended place to keep them, and loading a present
# .env now prints a one-time deprecation notice per process.
LITELLM_MASTER_KEY=sk-change-me
MASSA_VAULT_SERVER_CONFIG_PATH=config/server.config.json
MASSA_VAULT_SERVER_STATE_PATH=.automation/server/state.json
MASSA_VAULT_SERVER_LOG_DIR=.logs/server
ROUTER_GATEWAY_PORT=4100
ROUTER_LITELLM_BASE_URL=http://127.0.0.1:4000
ROUTER_POLICY_PATH=.litellm/router.json
ROUTER_GATEWAY_REQUIRE_SMART_ROUTER_MODEL=true

NOTES_AUTOMATION_ENABLED=true
NOTES_AUTOMATION_PUSH_INTERVAL_MIN=10
NOTES_AUTOMATION_REMOTE=origin
NOTES_AUTOMATION_BRANCH=master
VAULT_PATH=/absolute/path/to/your/obsidian-vault
NOTES_AUTOMATION_GIT_REPO_URL=
NOTES_AUTOMATION_GIT_AUTO_PUSH=true
NOTES_AUTOMATION_GDRIVE_BIN=rclone
NOTES_AUTOMATION_GDRIVE_REMOTE_PATH=

MASSA_VAULT_CLI_CONFIG_PATH=config/vault-cli.config.json
MASSA_VAULT_CHAT_GATEWAY_URL=http://127.0.0.1:4100
MASSA_VAULT_CHAT_MODEL=smart-router
MASSA_VAULT_CHAT_RAG=on
MASSA_VAULT_CHAT_IDLE_SYNC_MS=30000
MASSA_VAULT_CHAT_SYSTEM_PROMPT=
MASSA_VAULT_OLLAMA_URL=http://127.0.0.1:11434
MASSA_VAULT_EMBED_MODEL=embeddinggemma
