{
  "name": "massa-vault-tools",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "massa-vault": "./tools/cli.js",
    "massa-vault-server": "./tools/server/src/cli.js"
  },
  "engines": {
    "node": ">=25.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^6.2.3",
    "ink-text-input": "^6.0.0",
    "react": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0",
    "oxlint": "1.76.0"
  },
  "scripts": {
    "build": "npm test",
    "setup": "bash install.sh",
    "vault": "node tools/cli.js",
    "vault:install": "node tools/cli.js install",
    "vault:configure": "node tools/cli.js configure",
    "vault:start": "node tools/cli.js start",
    "vault:chat": "node tools/cli.js chat",
    "vault:sync": "node tools/cli.js sync",
    "vault:stop": "node tools/cli.js stop",
    "vault:status": "node tools/cli.js status",
    "vault:flush-sync": "node tools/cli.js flush-sync",
    "vault:resume": "node tools/cli.js resume",
    "vault:mcp": "node tools/server/src/cli.js run --only mcp-server",
    "server": "node tools/server/src/cli.js",
    "server:start": "node tools/server/src/cli.js start",
    "server:stop": "node tools/server/src/cli.js stop",
    "server:restart": "node tools/server/src/cli.js restart",
    "server:status": "node tools/server/src/cli.js status --json",
    "mcp-server": "node tools/server/src/cli.js run --only mcp-server",
    "router-gateway": "node tools/server/src/cli.js run --only router-gateway",
    "litellm": "node tools/server/src/cli.js run --only litellm",
    "notes-automation": "node tools/notes-automation/src/cli.js",
    "notes-automation:start": "node tools/notes-automation/src/cli.js start",
    "notes-automation:stop": "node tools/notes-automation/src/cli.js stop",
    "notes-automation:status": "node tools/notes-automation/src/cli.js status",
    "notes-automation:sync": "node tools/notes-automation/src/cli.js sync",
    "notes-automation:flush-push": "node tools/notes-automation/src/cli.js flush-push",
    "notes-automation:flush-sync": "node tools/notes-automation/src/cli.js flush-sync",
    "notes-automation:resume": "node tools/notes-automation/src/cli.js resume",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "release:version": "node scripts/release-version.js",
    "security:scan": "node tools/security/scan-secrets.js --staged",
    "security:scan:all": "node tools/security/scan-secrets.js --all",
    "hooks:install": "bash tools/security/install-hooks.sh",
    "test": "node --test"
  }
}
