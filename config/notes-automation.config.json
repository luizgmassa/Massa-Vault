{
  "enabled": true,
  "vault_path": ".",
  "watch_paths": [
    "."
  ],
  "include_globs": [
    "**/*.md",
    "templates/**/*.md",
    ".obsidian/app.json",
    ".obsidian/community-plugins.json",
    ".obsidian/core-plugins.json"
  ],
  "ignore_globs": [
    ".git/**",
    ".automation/**",
    ".DS_Store",
    "**/.DS_Store",
    ".logs/**",
    ".obsidian/workspace.json",
    ".obsidian/plugins/**/data.json",
    ".obsidian/plugins/**/cache/**",
    ".obsidian/plugins/**/tmp/**",
    ".litellm/.venv/**",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.pdf",
    "**/*.zip"
  ],
  "push_interval_min": 10,
  "sync_strategy": "git",
  "git_mode": "remote",
  "git_repo_url": "",
  "git_auto_push": true,
  "remote": "origin",
  "branch": "master",
  "gdrive_binary": "rclone",
  "gdrive_remote_path": "",
  "gdrive_mode": "bisync",
  "gdrive_first_run_resync": true,
  "gdrive_args": [
    "--exclude",
    ".git/**",
    "--exclude",
    ".obsidian/workspace.json",
    "--exclude",
    ".automation/**",
    "--exclude",
    ".DS_Store",
    "--exclude",
    "**/.DS_Store"
  ],
  "debounce_ms": 1500
}
